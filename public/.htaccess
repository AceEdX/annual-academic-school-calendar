# Lets direct links like /calendar, /auth and /reset-password open the app
# when the site is hosted on Apache/LiteSpeed (e.g. Hostinger).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
